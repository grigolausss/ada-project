# --- App Configuration ---
# This is a secret key for signing session data.
# In a real production environment, this should be a long, random string.
# You can generate one using: python -c 'import secrets; print(secrets.token_hex(16))'
SECRET_KEY=a-very-secret-key-that-should-be-changed

# --- Database Configuration ---
# The application will use a file-based SQLite database by default.
# The path points to a file named 'app.db' inside an 'instance' folder.
# You generally don't need to change this for development.
DATABASE_URL=

# --- Email "Postino" (Sender) Configuration ---
# These settings are for the email account the application uses to send OTPs.
# For Gmail, you will need to generate a 16-character "App Password".
# See Google's help pages for instructions.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
